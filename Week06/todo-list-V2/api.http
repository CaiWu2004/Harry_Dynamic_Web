### get every todo
GET http://localhost:3001/todos HTTP/1.1
Content-Type: application/json

### create a todo -- the server gives it an id now
POST http://localhost:3001/todos HTTP/1.1
Content-Type: application/json

{
  "title": "a todo made in vs code"
}

### replace one by ID(PUT replaces the entire record)
PUT http://localhost:3001/todos/1 HTTP/1.1
Content-Type: application/json

{
  "title":"an edited todo"
}

### change one field and leave the rest alone (also by ID)
PATCH http://localhost:3001/todos/1 HTTP/1.1
Content-Type: application/json

{
  "done": "true"
}

###delete a todo by id
DELETE  http://localhost:3001/todos/2 HTTP/1.1
Content-Type: application/json

